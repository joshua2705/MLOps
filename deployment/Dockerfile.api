FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir fastapi "uvicorn[standard]" pydantic joblib scikit-learn numpy python-dotenv

COPY prediction_contract/ /app/prediction_contract/
COPY runtime/ /app/runtime/
COPY artifact_storage/ /app/artifact_storage/

ENV PYTHONPATH=/app
ENV CESAR_MODEL_PATH=/app/artifact_storage/model_minimal.joblib
ENV CESAR_CONTRACT_PATH=/app/artifact_storage/contract_minimal.json

EXPOSE 8000

CMD ["uvicorn", "runtime.prediction_api.app:app", "--host", "0.0.0.0", "--port", "8000"]
